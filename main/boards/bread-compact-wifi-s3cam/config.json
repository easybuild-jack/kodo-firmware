{
    "type": "bread-compact-wifi-s3cam",
    "target": "esp32s3",
    "builds": [
        {
            "name": "bread-compact-wifi-s3cam",
            "build_options": {
                "camera_hmirror": false,
                "camera_vflip": false
            },
            "sdkconfig_append": [
                "CONFIG_LCD_ST7789_240X320=y",
                "CONFIG_OTA_URL=\"http://192.168.8.11:8000/xiaozhi/ota/\"",
                "CONFIG_XIAOZHI_CAMERA_ALLOW_JPEG_INPUT=y"
            ]
        }
    ]
}
